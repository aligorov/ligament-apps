<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ligament.link-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Ligament 2FA.app/Contents/MacOS/link-agent</string>
