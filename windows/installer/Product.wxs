<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Версию передаёт build_msi.ps1 из pubspec.yaml (-dProductVersion):
       зашитая константа приводила к тому, что каждая сборка (Product Id="*")
       ставилась ОТДЕЛЬНОЙ записью в «Программы и компоненты» — MajorUpgrade
       не считает равную версию апгрейдом. AllowSameVersionUpgrades —
       страховка от забытого бампа pubspec: равная версия заменяет старую. -->
  <Product Id="*"
           Name="Ligament 2FA Authenticator"
           Language="1033"
           Codepage="1252"
           Version="$(var.ProductVersion)"
           Manufacturer="Ligament Security"
           UpgradeCode="4B5F3776-E1E7-44E8-BAA5-7FD81CE1B732">
    <Package InstallerVersion="301" Compressed="yes" InstallScope="perMachine" Platform="x64" Description="Ligament 2FA Client Installer" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Ligament 2FA is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- ОДИН полный пакет (требование 2026-10-04): приложение + RDP
         Credential Provider + служба Ligament2FAService ставятся вместе,
         отдельного ZIP-артефакта больше нет. 2FA входа (RDP и консоль)
         при этом ВЫКЛЮЧЕНА по умолчанию: RDP2FAEnabled=0/Console2FAEnabled=0
         в локальных дефолтах и в коде CP — включение только явной политикой
         (GPO / HKLM\SOFTWARE\Policies\Ligament\2FA). Служба-сторож
         активна только при AllowExit=0 (см. windows/service). -->
    <Feature Id="ProductFeature" Title="Ligament 2FA" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="AutoStartupRegistry" />
      <ComponentRef Id="AppServerUrlRegistry" />
      <ComponentRef Id="UrlProtocolRegistry" />
      <ComponentRef Id="CredentialProviderComponent" />
      <ComponentRef Id="RdpWebAuthnPolicyComponent" />
      <ComponentRef Id="LigamentServiceComponent" />
      <ComponentRef Id="EndpointServiceComponent" />
    </Feature>

    <Icon Id="AppIcon.ico" SourceFile="windows/runner/resources/app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <!-- SERVERURL: адрес сервера 2FA при установке из командной строки:
         msiexec /i Ligament-2FA-Windows-x64.msi SERVERURL=https://2fa.example.corp
         Свойство не задано — считывается существующее значение из реестра HKLM,
         сохраняя конфигурацию при обновлении/переустановке без параметров. -->
    <Property Id="SERVERURL" Secure="yes">
      <RegistrySearch Id="ExistingServerUrl"
                      Root="HKLM"
                      Key="SOFTWARE\Ligament\2FA"
                      Name="ServerURL"
                      Type="raw" />
    </Property>
    <!-- RDPAGENTKEY: ключ endpoint-службы RDP Access Gateway (формат
         «<endpoint_uuid>:<agent_key_hex>», выдаётся админом при создании
         agent-endpoint в 2fa). msiexec /i Ligament-2FA-Windows-x64.msi
         RDPAGENTKEY=<uuid>:<hex> — значение уходит в
         HKLM\SOFTWARE\Ligament\2FA\RdpAgentKey (EndpointServiceComponent),
         службу читает его при старте. Не задан на CLI — считывается
         существующий ключ из реестра, предотвращая затирание при обновлении.
         Hidden=yes: ключ — секрет, msiexec /l*v и UI установки не должны
         раскрывать его значение. -->
    <Property Id="RDPAGENTKEY" Secure="yes" Hidden="yes">
      <RegistrySearch Id="ExistingRdpAgentKey"
                      Root="HKLM"
                      Key="SOFTWARE\Ligament\2FA"
                      Name="RdpAgentKey"
                      Type="raw" />
    </Property>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Ligament 2FA" />
      </Directory>
      <Directory Id="System64Folder" />
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Ligament 2FA" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="7244B7E0-ACFA-4FE0-9ED9-F04E313D9C33" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Ligament 2FA"
                  Description="Ligament Enterprise 2FA Authenticator"
                  Target="[INSTALLFOLDER]ligament_authenticator.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Ligament\2FA" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AutoStartupRegistry" Guid="83C6F77B-4B52-47C2-B812-9A4B39ECDA19" Win64="yes">
        <!-- Run on Windows startup -->
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Ligament2FA"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]ligament_authenticator.exe&quot; --minimized"
                       KeyPath="yes" />
      </Component>

      <!-- Реестр ServerURL принадлежит приложению (ProductFeature, ставится
           всегда): адрес сервера нужен и десктоп-клиенту, и CP. Credential
           Provider читает тот же ключ SOFTWARE\Ligament\2FA\ServerURL, но не
           владеет значением — без CP-feature оно всё равно будет в реестре. -->
      <Component Id="AppServerUrlRegistry" Guid="ADA3283C-1B4A-4DAE-8AC6-D931728C7E3B" Win64="yes">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Ligament\2FA"
                       Name="ServerURL"
                       Type="string"
                       Value="[SERVERURL]"
                       KeyPath="yes" />
      </Component>

      <!-- Схема URL ligament:// (T6, аудит RDP-11): HKCR\ligament —
           «URL Protocol» объявляет схему Windows, shell\open\command
           запускает приложение и передаёт URI в %1 (холодный старт:
           windows/runner/main.cpp пробрасывает argv в Dart,
           ligamentUriFromArgs). Контракт ссылки — ТОЛЬКО целевой
           идентификатор (ligament://rdp/<target_uuid> либо легаси
           ligament://rdp/<grant_id>): НИКАКИХ грант-токенов/секретов в
           URI — командная строка видна любому процессу (урок аудита).
           perMachine-пакет пишет HKCR → HKLM\SOFTWARE\Classes; отдельной
           HKCU-ветки нет (установка только машинная, InstallScope выше).
           KeyPath — RegistryValue «URL Protocol» (пустое имя = значение
           ключа по умолчанию), как у ApplicationShortcut-паттерна. -->
      <Component Id="UrlProtocolRegistry" Guid="0D9E4F61-8C2B-47D3-9A6E-5F80B2C4D917" Win64="yes">
        <RegistryKey Root="HKCR" Key="ligament">
          <RegistryValue Type="string" Value="URL:Ligament 2FA deep link" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]ligament_authenticator.exe,1" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]ligament_authenticator.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="System64Folder">
      <!-- Ligament 2FA Windows Credential Provider DLL & COM/Security
           Registration. Ставится ВСЕГДА (единый полный пакет); 2FA входа
           выключена по умолчанию — включение только политикой. -->
      <Component Id="CredentialProviderComponent" Guid="A3B7C9D1-5E2F-4A8B-9C0D-1E2F3A4B5C6D" Win64="yes">
        <File Id="LigamentCPDll"
              Name="LigamentCredentialProvider.dll"
              Source="windows/credential_provider/build/Release/LigamentCredentialProvider.dll"
              KeyPath="yes" />

        <!-- COM InprocServer32 Registration -->
        <RegistryKey Root="HKCR" Key="CLSID\{7B896B21-8B35-4E7B-A350-9E17E5E3D10A}">
          <RegistryValue Type="string" Value="Ligament 2FA Credential Provider" />
          <RegistryKey Key="InprocServer32">
            <RegistryValue Type="string" Value="[System64Folder]LigamentCredentialProvider.dll" />
            <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
          </RegistryKey>
        </RegistryKey>

        <!-- Windows Credential Provider Registration -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{7B896B21-8B35-4E7B-A350-9E17E5E3D10A}">
          <RegistryValue Type="string" Value="Ligament 2FA Credential Provider" />
        </RegistryKey>

        <!-- Windows Credential Provider Filter Registration -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Provider Filters\{7B896B21-8B35-4E7B-A350-9E17E5E3D10A}">
          <RegistryValue Type="string" Value="Ligament 2FA Credential Provider Filter" />
        </RegistryKey>

        <!-- Local Default Settings. RDP2FAEnabled=0: провайдер может быть
             установлен, но 2FA для RDP по умолчанию ВЫКЛЮЧЕНА — включается
             только явной политикой HKLM\SOFTWARE\Policies\Ligament\2FA
             (RDP2FAEnabled=1) или GPO-шаблоном. Elevation2FAEnabled=0 —
             2FA на повышение прав (UAC) аналогично opt-in, включается
             политикой Elevation2FAEnabled=1. ServerURL сюда не входит —
             значением владеет AppServerUrlRegistry из ProductFeature. -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Ligament\2FA">
          <RegistryValue Name="RDP2FAEnabled" Type="integer" Value="0" />
          <RegistryValue Name="Console2FAEnabled" Type="integer" Value="0" />
          <RegistryValue Name="Elevation2FAEnabled" Type="integer" Value="0" />
          <RegistryValue Name="FIDO2Enabled" Type="integer" Value="1" />
          <RegistryValue Name="DefaultFactor" Type="integer" Value="0" />
          <RegistryValue Name="PushTimeoutSeconds" Type="integer" Value="45" />
          <RegistryValue Name="FailClose" Type="integer" Value="1" />
          <RegistryValue Name="AllowSelfSigned" Type="integer" Value="0" />
          <RegistryValue Name="BypassAccounts" Type="string" Value="" />
        </RegistryKey>
      </Component>

      <!-- Enable RDP WebAuthn Redirection for FIDO2/YubiKey -->
      <Component Id="RdpWebAuthnPolicyComponent" Guid="B4C8D0E2-6F3A-4B9C-AD1E-2F3A4B5C6D7E" Win64="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services">
          <RegistryValue Name="fEnableWebAuthn" Type="integer" Value="1" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Ligament 2FA Service (watchdog): exe лежит рядом с приложением.
           Auto-start, LocalSystem. Активна только при AllowExit=0:
           перезапускает клиент в активных пользовательских сессиях, если
           процесс убит. При AllowExit=1 (по умолчанию) пассивна. -->
      <Component Id="LigamentServiceComponent" Guid="C4D8E0F2-7A4B-4C3E-9D5E-6F7A8B9C0D1E" Win64="yes">
        <File Id="LigamentServiceExe"
              Name="ligament_service.exe"
              Source="windows/service/build/Release/ligament_service.exe"
              KeyPath="yes" />
        <ServiceInstall Name="Ligament2FAService"
                        DisplayName="Ligament 2FA Service"
                        Description="Ligament 2FA watchdog: keeps the client running where exit is disabled by policy (AllowExit=0)"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="ignore" />
        <ServiceControl Id="Ligament2FAServiceControl"
                        Name="Ligament2FAService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall" />
      </Component>

      <!-- Ligament Endpoint Service (RDP Access Gateway, этап 2.3):
           endpoint_service.cpp → ligament_endpoint.exe, ставится как
           endpoint_service.exe рядом с приложением. Служба сама инициирует
           исходящий WSS к ядру 2fa (входящих портов нет), регистрируется
           по agent_key и по команде ядра открывает TCP только на
           127.0.0.1:3389 (loopback-allowlist в коде службы). Auto-start,
           LocalSystem (Account не указан — WiX по умолчанию ставит службу
           от LocalSystem), пассивна без RdpAgentKey/RdpAgentEnabled=1.
           RDPAGENTKEY передаётся при установке и уходит в реестр. -->
      <Component Id="EndpointServiceComponent" Guid="5733C8DD-453E-4EEE-ADBB-609D7EA8E0D8" Win64="yes">
        <File Id="LigamentEndpointServiceExe"
              Name="endpoint_service.exe"
              Source="windows/endpoint_service/build/Release/ligament_endpoint.exe"
              KeyPath="yes" />
        <ServiceInstall Name="LigamentEndpointService"
                        DisplayName="Ligament Endpoint Service"
                        Description="Ligament RDP Access Gateway endpoint service: outbound WSS tunnel to the 2FA core, dials loopback RDP (127.0.0.1:3389) on demand"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="ignore" />
        <ServiceControl Id="LigamentEndpointServiceControl"
                        Name="LigamentEndpointService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall" />
        <!-- Ключ endpoint-службы из MSI-свойства RDPAGENTKEY (см. Product).
             KeyPath — File выше (обязателен для ServiceInstall), реестр —
             сопутствующий ресурс компонента. -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Ligament\2FA"
                       Name="RdpAgentKey"
                       Type="string"
                       Value="[RDPAGENTKEY]" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
